                </Border.StrokeShape>
                <FlexLayout Direction="Row"
                            Wrap="Wrap">
                    <Label Text="DRAGOMIR Bogdan Cosmin - "
                           FontSize="17"
                           TextColor="#F3F7FF" />
                    <Label Text="dragomircosmin20@stud.ase.ro"
