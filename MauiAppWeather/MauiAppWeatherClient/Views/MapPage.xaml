<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:MauiAppWeatherClient.Resources.Localization"
    x:Class="MauiAppWeatherClient.Views.MapPage"
    Title="{x:Static res:AppResources.Map}">

   <ContentPage.Content>
      <OnPlatform x:TypeArguments="View">
         <On Platform="Android">
            <Grid>
               <WebView x:Name="MapWebView" />
               <VerticalStackLayout
                  x:Name="EmptyStateContainer"
                  IsVisible="False"
                  VerticalOptions="Center"
                  HorizontalOptions="Center">
                  <Label
                     Text="{x:Static res:AppResources.UnavailableMap}"
                     HorizontalTextAlignment="Center" />
                  <Label
                     Text="{x:Static res:AppResources.AndroidOnly}"
                     HorizontalTextAlignment="Center" />
               </VerticalStackLayout>
            </Grid>
         </On>

         <On Platform="WinUI">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
               <Label Text="{x:Static res:AppResources.UnavailableMap}"
                  HorizontalTextAlignment="Center"/>
               <Label Text="{x:Static res:AppResources.AndroidOnly}"
                  HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
         </On>
      </OnPlatform>
   </ContentPage.Content>
</ContentPage>
