<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiAppWeatherModel;assembly=MauiAppWeatherModel"
             x:Class="MauiAppWeatherClient.Views.NewLocationPage"
             Title="New Location">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <SearchBar Placeholder="Caută după Nume sau Cod ZIP..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />

            <Label Text="Search result:" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding SearchResult}" HeightRequest="150">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocationDto">
                        <Grid Padding="10" ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding CityName}" FontAttributes="Bold" />
                                <Label Text="{Binding ZipCode}" FontSize="12" TextColor="Black" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Add"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <Label Text="Saved Locations:" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding SavedLocations}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Location">
                        <Grid Padding="10" ColumnDefinitions="*, Auto, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding CityName}" FontAttributes="Bold" />
                                <Label Text="{Binding ZipCode}" FontSize="12" TextColor="Black" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Select"
                                    Margin="0,0,5,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="2"
                                    Text="Delete"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>