<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:MauiAppWeatherClient.Resources.Localization"
             xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
             xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
             x:Class="MauiAppWeatherClient.Views.SettingsPage"
             Title="SettingsPage">
   <ScrollView>
      <VerticalStackLayout Padding="20" Spacing="25">
         <Label Text="{x:Static res:AppResources.UserName}" FontSize="20" FontAttributes="Bold"/>
         <Entry Placeholder="{x:Static res:AppResources.Name}" Text="{Binding Name}" />
         <Entry Placeholder="{x:Static res:AppResources.Email}" Text="{Binding Email}" />
         <Label Text="{x:Static res:AppResources.General}" FontSize="20" FontAttributes="Bold" />
         <Label Text="{x:Static res:AppResources.Language}" />
         <Picker Title="{x:Static res:AppResources.SelectLanguage}" SelectedItem="{Binding Language}" 
            ItemsSource="{Binding Languages}}">
         </Picker>
         <Label Text="{x:Static res:AppResources.Temperature}" FontSize="20" FontAttributes="Bold"/>

         <HorizontalStackLayout Spacing="20">
            <RadioButton Content="{x:Static res:AppResources.Celsius}"
               GroupName="Temp" IsChecked="{Binding IsCelsius}" />
            <RadioButton Content="{x:Static res:AppResources.Fahrenheit}"
               GroupName="Temp" IsChecked="{Binding IsFahrenheit}" />
         </HorizontalStackLayout>

         <Button Text="{x:Static res:AppResources.Save}" Command="{Binding SaveCommand}" HeightRequest="50" />
      </VerticalStackLayout>
   </ScrollView>
</ContentPage>