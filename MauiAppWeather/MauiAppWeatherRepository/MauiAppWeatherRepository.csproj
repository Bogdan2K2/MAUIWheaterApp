<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
         net10.0-windows10.0.19041.0
      </TargetFrameworks>

      <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux')) OR $([MSBuild]::IsOSPlatform('osx'))">
         net10.0-android
      </TargetFrameworks>
      <UseMaui>true</UseMaui>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\MauiAppWeatherModel\MauiAppWeatherModel.csproj" />
   </ItemGroup>

</Project>